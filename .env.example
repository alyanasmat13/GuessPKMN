# Frontend (Vite) environment variables.
# Copy this file to ".env" and fill in the values. Anything prefixed with
# VITE_ is embedded into the client bundle (do not put real secrets here).

# Backend API base URL.
# - Development: leave EMPTY to use the Vite dev proxy (-> localhost:3002).
# - Production:  set to your deployed backend URL, e.g.
#   VITE_API_URL=https://guesspkmn-api.onrender.com
VITE_API_URL=

# Firebase web config (from the Firebase console > Project settings).
# These are public identifiers, not secrets; Firestore access is enforced by
# firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
