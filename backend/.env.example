# Backend (Express) environment variables. Copy to backend/.env and adjust.

PORT=3002
API_BASE_URL=https://pokeapi.co/api/v2/pokemon
MAX_POKEMON_ID=1025

# "development" or "production". In production, error messages are masked and
# HSTS is enforced.
NODE_ENV=development

# Comma-separated CORS allowlist. Add your deployed frontend URL in production,
# e.g. FRONTEND_URL=https://guesspkmn.vercel.app
FRONTEND_URL=http://localhost:5173

# SSE connection limits (optional overrides)
MAX_SSE_CONNECTIONS_PER_IP=5
MAX_SSE_CONNECTIONS_TOTAL=500

# Rate limiting (optional overrides). Defaults are generous enough to be
# invisible during normal play and only trip under abusive traffic.
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_NEXT_WINDOW_MS=60000
RATE_LIMIT_NEXT_MAX=120
